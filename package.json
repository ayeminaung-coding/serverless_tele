{
  "name": "telegram-serverless",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless Telegram channel video publisher (Cloudflare Workers + D1 + R2)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:create": "wrangler d1 create telegram-serverless",
    "db:migrate": "wrangler d1 migrations apply telegram-serverless --remote"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
